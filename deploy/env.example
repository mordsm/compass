COMPASS_ACTIONS_API_KEY=replace-with-a-strong-secret
COMPASS_PUBLIC_BASE_URL=https://compass.example.com
COMPASS_USER_ID=moshe

# Existing sibling services. Leave as localhost only if they run on the same host.
COMPASS_SELF_MANAGE_BASE_URL=http://127.0.0.1:8001
COMPASS_ASSESSMENT_BASE_URL=http://127.0.0.1:8002
COMPASS_RULES_ENGINE_BASE_URL=http://127.0.0.1:8003
COMPASS_MAIL_MANAGER_BASE_URL=http://127.0.0.1:8004
COMPASS_ECONOMIC_SPENDING_BASE_URL=http://127.0.0.1:8005
COMPASS_TASK_COMMANDER_BASE_URL=http://127.0.0.1:8006
COMPASS_ADMINISTRATIVE_BASE_URL=http://127.0.0.1:8007

# From Cloudflare Zero Trust after creating a remotely-managed tunnel.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
